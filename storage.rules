rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reglas para archivos privados de usuario (ej. fotos de perfil)
    // Un usuario solo puede leer y escribir en su propia carpeta de Storage.
    match /users/{userId}/{allFiles=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para archivos de la comunidad (ej. imágenes de posts)
    // Cualquier usuario autenticado puede leer.
    // Solo usuarios autenticados pueden escribir, y la ruta debe ser segura (ej. /community_posts/userId/imageId).
    match /community_posts/{userId}/{allFiles=**} {
      allow read: if request.auth != null; // Cualquier autenticado puede ver
      allow write: if request.auth != null && request.auth.uid == userId; // Solo el dueño puede subir a su subcarpeta
    }

    // Opcional: Si tienes una carpeta para imágenes públicas que cualquiera puede ver
    // match /public_images/{imageId} {
    //   allow read: if true; // Cualquiera puede leer
    //   allow write: if request.auth != null; // Solo autenticados pueden subir
    // }

    // Regla por defecto: Denegar cualquier otra cosa no especificada arriba.
    // Esto es muy importante para la seguridad.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}